{"groups":[[["Āṭānāṭiya suttaṃ","The Āṭānāṭiya Discourse"]],[["Atha kho","Then"],["Bhagavā","the Blessed One,"],["Tassā rattiyā accayena","when that night had passed,"],["Bhikkhū āmantesi","addressed the monks:"]],[["Imaṃ bhikkhave rattiṃ","\"Last night, monks,"],["Cattāro mahārājāno","the Four Great Kings,"],["Mahatiyā ca yakkhasenāya","with a great army of yakkhas,"],["Mahatiyā ca gandhabbasenāya","with a great army of gandhabbas,"],["Mahatiyā ca kumbhaṇḍasenāya","with a great army of kumbhaṇḍas,"],["Mahatiyā ca nāgasenāya","and with a great army of nāgas,"]],[["Catuddisaṃ rakkhaṃ ṭhapetvā","having set a guard over the four quarters,"],["Catuddisaṃ gumbaṃ ṭhapetvā","having stationed troops over the four quarters,"],["Catuddisaṃ ovaraṇaṃ ṭhapetvā","having posted a barrier over the four quarters,"]],[["Abhikkantāya rattiyā","when the night was far advanced,"],["Abhikkantavaṇṇā","of surpassing beauty,"],["Kevalakappaṃ gijjhakūṭaṃ pabbataṃ","the whole of Vulture Peak mountain"],["Obhāsetvā","illuminating,"],["Yenāhaṃ","to where I was"],["Tenupasaṅkamiṃsu","they approached."]],[["Upasaṅkamitvā","Having approached,"],["Maṃ abhivādetvā","they bowed to me"],["Ekamantaṃ nisīdiṃsu","and sat down to one side."]],[["Tepi kho bhikkhave yakkhā","And of those yakkhas, monks,"],["Appekacce","some"],["Maṃ abhivādetvā","bowed to me"],["Ekamantaṃ nisīdiṃsu","and sat down to one side."]],[["Appekacce","Some"],["Mama saddhiṃ","with me"],["Sammodiṃsu","exchanged greetings,"],["Sammodanīyaṃ kathaṃ","and after pleasant talk,"],["Sārāṇīyaṃ","courteous and memorable,"],["Vītisāretvā","had been concluded,"],["Ekamantaṃ nisīdiṃsu","sat down to one side."]],[["Appekacce","Some,"],["Yenāhaṃ","towards where I was"],["Tenañjalimpaṇāmetvā","raising their joined palms,"],["Ekamantaṃ nisīdiṃsu","sat down to one side."]],[["Appekacce","Some,"],["Nāmagottaṃ sāvetvā","announcing their name and clan,"],["Ekamantaṃ nisīdiṃsu","sat down to one side."],["Appekacce","Some,"],["Tuṇhībhūtā","remaining silent,"],["Ekamantaṃ nisīdiṃsu","sat down to one side."]],[["Ekamantaṃ nisinno kho bhikkhave","Seated to one side, monks,"],["Vessavaṇo mahārājā","the great king Vessavaṇa"],["Maṃ etadavoca","said this to me:"]],[["Santi hi bhante","There are, venerable sir,"],["Uḷārā yakkhā","eminent yakkhas"],["Bhagavato appasannā","who have no faith in the Blessed One."],["Santi hi bhante","There are, venerable sir,"],["Uḷārā yakkhā","eminent yakkhas"],["Bhagavato pasannā","who have faith in the Blessed One."]],[["Santi hi bhante","There are, venerable sir,"],["Majjhimā yakkhā","middling yakkhas"],["Bhagavato appasannā","who have no faith in the Blessed One."],["Santi hi bhante","There are, venerable sir,"],["Majjhimā yakkhā","middling yakkhas"],["Bhagavato pasannā","who have faith in the Blessed One."]],[["Santi hi bhante","There are, venerable sir,"],["Nīcā yakkhā","lowly yakkhas"],["Bhagavato appasannā","who have no faith in the Blessed One."],["Santi hi bhante","There are, venerable sir,"],["Nīcā yakkhā","lowly yakkhas"],["Bhagavato pasannā","who have faith in the Blessed One."]],[["Yebhuyyena kho pana bhante","But for the most part, venerable sir,"],["Yakkhā","the yakkhas"],["Appasannā yeva","are indeed without faith"],["Bhagavato","in the Blessed One."],["Taṃ kissa hetu","What is the reason for that?"]],[["Bhagavā hi bhante","Because the Blessed One, venerable sir,"],["Pāṇātipātā veramaṇiyā","for abstaining from killing living beings"],["Dhammaṃ deseti","teaches the Dhamma;"],["Adinnādānā veramaṇiyā","for abstaining from taking what is not given"],["Dhammaṃ deseti","he teaches the Dhamma;"]],[["Kāmesu micchācārā veramaṇiyā","for abstaining from sexual misconduct"],["Dhammaṃ deseti","he teaches the Dhamma;"],["Musāvādā veramaṇiyā","for abstaining from false speech"],["Dhammaṃ deseti","he teaches the Dhamma;"],["Surāmerayamajjappamādaṭṭhānā veramaṇiyā","for abstaining from liquor and intoxicants that cause heedlessness"],["Dhammaṃ deseti","he teaches the Dhamma."]],[["Yebhuyyena kho pana bhante","But for the most part, venerable sir,"],["Yakkhā","the yakkhas"],["Appaṭiviratā yeva pāṇātipātā","do not abstain from killing living beings,"],["Appaṭiviratā adinnādānā","do not abstain from taking what is not given,"],["Appaṭiviratā kāmesu micchācārā","do not abstain from sexual misconduct,"],["Appaṭiviratā musāvādā","do not abstain from false speech,"],["Appaṭiviratā surāmerayamajjappamādaṭṭhānā","do not abstain from liquor and intoxicants that cause heedlessness."]],[["Tesaṃ taṃ","To them that teaching"],["Hoti appiyaṃ amanāpaṃ","is unwelcome and displeasing."]],[["Santi hi bhante","There are, venerable sir,"],["Bhagavato sāvakā","disciples of the Blessed One"],["Araññe","who in the wilderness,"],["Vanapatthāni","deep in the forest,"],["Pantāni senāsanāni","remote lodgings"],["Paṭisevanti","resort to,"]],[["Appasaddāni","where there is little sound,"],["Appanigghosāni","little noise,"],["Vijanavātāni","far from the bustle of people,"],["Manussarāhaseyyakāni","hidden away from humankind,"],["Paṭisallānasāruppāni","suitable for seclusion."]],[["Tattha","There"],["Santi","dwell"],["Uḷārā yakkhā","eminent yakkhas"],["Nivāsino","as residents,"],["Ye","who"],["Imasmiṃ bhagavato pāvacane","in this teaching of the Blessed One"],["Appasannā","have no faith."]],[["Tesaṃ pasādāya","So that they may gain faith,"],["Uggaṇhātu","may he learn,"],["Bhante bhagavā","venerable sir, the Blessed One,"],["Āṭānāṭiyaṃ rakkhaṃ","the Āṭānāṭiya protection,"]],[["Bhikkhūnaṃ","for the monks,"],["Bhikkhunīnaṃ","the nuns,"],["Upāsakānaṃ","the laymen"],["Upāsikānaṃ","and the laywomen,"],["Guttiyā","for their guarding,"],["Rakkhāya","for their protection,"],["Avihiṃsāya","for their freedom from harm,"],["Phāsuvihārāyāti","and for their dwelling in comfort."]],[["Adhivāsesiṃ kho ahaṃ bhikkhave","I consented, monks,"],["Tuṇhībhāvena","by remaining silent."]],[["Atha kho bhikkhave","Then, monks,"],["Vessavaṇo mahārājā","the great king Vessavaṇa,"],["Me adhivāsanaṃ","my consent"],["Viditvā","having understood,"],["Tāyaṃ velāyaṃ","on that occasion"],["Imaṃ āṭānāṭiyaṃ rakkhaṃ","this Āṭānāṭiya protection"],["Abhāsi","recited:"]],[["Vipassissa namatthu","Homage to Vipassī,"],["Cakkhumantassa","the one with vision,"],["Sirīmato","the glorious."],["Sikhissa pi namatthu","Homage also to Sikhī,"],["Sabbabhūtānukampino","compassionate to all beings."]],[["Vessabhussa namatthu","Homage to Vessabhū,"],["Nhātakassa","the one washed clean,"],["Tapassino","the ascetic."],["Namatthu kakusandhassa","Homage to Kakusandha,"],["Mārasenappamaddino","crusher of Māra's army."]],[["Koṇāgamanassa namatthu","Homage to Koṇāgamana,"],["Brāhmaṇassa","the true brahmin,"],["Vusīmato","who has lived the holy life."],["Kassapassa ca namatthu","Homage to Kassapa,"],["Vippamuttassa sabbadhi","freed in every respect."]],[["Aṅgīrasassa namatthu","Homage to Aṅgīrasa,"],["Sakyaputtassa","son of the Sakyans,"],["Sirīmato","the glorious,"],["Yo","who"],["Imaṃ dhammamadesesi","taught this Dhamma"],["Sabbadukkhāpanūdanaṃ","that dispels all suffering."]],[["Ye cāpi","And those who"],["Nibbutā loke","are quenched in the world,"],["Yathābhūtaṃ","things as they really are"],["Vipassisuṃ","having clearly seen,"],["Te janā","those people"],["Apisuṇā","are free of slander,"],["Mahantā","great,"],["Vītasāradā","and free from fear."]],[["Hitaṃ devamanussānaṃ","The benefactor of gods and humans,"],["Yaṃ namassanti gotamaṃ","Gotama, to whom they pay homage,"],["Vijjācaraṇasampannaṃ","perfect in knowledge and conduct,"],["Mahantaṃ","great,"],["Vītasāradaṃ","and free from fear."]],[["Yato uggacchati","Where rises"],["Suriyo","the sun,"],["Ādicco","child of Aditi,"],["Maṇḍalī mahā","the great orb,"],["Yassa cuggacchamānassa","at whose rising"],["Saṃvarī pi nirujjhati","the night comes to an end,"]],[["Yassa cuggate suriye","and when that sun has risen"],["Divaso’ti pavuccati","it is called \"day\"."],["Rahado pi tattha","There is also a lake there,"],["Gambhīro","deep,"],["Samuddo","an ocean"],["Saritodako","of flowing waters."],["Evaṃ naṃ tattha jānanti","So they know it there:"],["Samuddo saritodako","\"the ocean of flowing waters\"."]],[["Ito","From here"],["Sā purimā disā","that is the eastern quarter,"],["Iti naṃ ācikkhatī jano","so the people call it,"],["Yaṃ disaṃ abhipāleti","the quarter that is guarded by"],["Mahārājā yasassi so","that glorious great king."]],[["Gandhabbānaṃ ādhipati","Lord of the gandhabbas,"],["Dhataraṭṭho iti nāmaso","Dhataraṭṭha is his name."],["Ramatī naccagītehi","He delights in dance and song,"],["Gandhabbehi purakkhato","honoured by the gandhabbas."]],[["Puttā pi tassa bahavo","He has many sons too,"],["Ekanāmā’ti me sutaṃ","all of one name, so I have heard:"],["Asītiṃ dasa eko ca","eighty and ten and one,"],["Indanāmā","Inda by name,"],["Mahabbalā","of mighty strength."]],[["Te cāpi","They too,"],["Buddhaṃ disvāna","having seen the Buddha,"],["Buddhaṃ ādiccabandhunaṃ","the Buddha, kinsman of the sun,"],["Dūrato’va namassanti","pay homage from afar"],["Mahantaṃ vītasāradaṃ","to the great one, free from fear:"],["Namo te purisājañña","\"Homage to you, thoroughbred among men!"],["Namo te purisuttama","Homage to you, supreme among men!"]],[["Kusalena samekkhasi","With skilful insight you look upon us;"],["Amanussāpi taṃ vandanti","even the non-humans worship you.\""],["Sutaṃ netaṃ abhiṇhaso","This we have heard again and again,"],["Tasmā evaṃ vademase","therefore we speak thus:"]],[["Jinaṃ vandatha gotamaṃ","\"Do you worship Gotama the Conqueror?\""],["Jinaṃ vandāma gotamaṃ","\"We worship Gotama the Conqueror;"],["Vijjācaraṇasampannaṃ","perfect in knowledge and conduct,"],["Buddhaṃ vandāma gotamaṃ","the Buddha Gotama we worship.\""]],[["Yena petā pavuccanti","Where the departed are said to go,"],["Pisuṇā","the slanderers,"],["Piṭṭhimaṃsikā","the backbiters,"],["Pāṇātipātino","the killers of living beings,"],["Ḷuddā","the cruel,"],["Corā","the thieves"],["Nekatikā janā","and the deceitful people,"]],[["Ito","From here"],["Sā dak