at ripens on untilled ground"],["Paribhuñjanti mānusā","the people eat."]],[["Akaṇaṃ athusaṃ","Free of bran and husk,"],["Suddhaṃ","pure,"],["Sugandhaṃ","fragrant"],["Taṇḍulapphalaṃ","grains of rice"],["Tuṇḍikīre pacitvāna","they cook in a pot,"],["Tato bhuñjanti bhojanaṃ","and then eat their meal."]],[["Gāviṃ ekakhuraṃ katvā","Making a cow their single-hoofed mount,"],["Anuyanti disodisaṃ","they ride about from place to place."],["Pasuṃ ekakhuraṃ katvā","Making a beast their single-hoofed mount,"],["Anuyanti disodisaṃ","they ride about from place to place."]],[["Itthivāhanaṃ katvā","Making women their vehicle,"],["Anuyanti disodisaṃ","they ride about from place to place."],["Purisavāhanaṃ katvā","Making men their vehicle,"],["Anuyanti disodisaṃ","they ride about from place to place."]],[["Kumārivāhanaṃ katvā","Making girls their vehicle,"],["Anuyanti disodisaṃ","they ride about from place to place."],["Kumāravāhanaṃ katvā","Making boys their vehicle,"],["Anuyanti disodisaṃ","they ride about from place to place."]],[["Te yāne abhirūhitvā","Mounting their vehicles,"],["Sabbā disā anupariyanti","they travel around in all directions,"],["Pacārā tassa rājino","the attendants of that king."],["Hatthiyānaṃ","Elephant vehicles,"],["Assayānaṃ","horse vehicles"],["Dibbaṃyānaṃ","and divine vehicles"],["Upaṭṭhitaṃ","stand ready."]],[["Pāsādā sivikā ceva","Palaces and palanquins too"],["Mahārājassa yasassino","belong to that glorious great king."],["Tassa ca nagarā ahu","And he has cities,"],["Antalikkhe sumāpitā","well built in the sky:"]],[["Āṭānāṭā","Āṭānāṭā,"],["Kusināṭā","Kusināṭā,"],["Parakusināṭā","Parakusināṭā,"],["Nāṭapuriyā","Nāṭapuriyā"],["Parakusitanāṭā","and Parakusitanāṭā."]],[["Uttarena kapivanto","To the north is Kapīvanta,"],["Janoghamaparena ca","and on the other side Janogha,"],["Navanavutiyo","Navanavutiya,"],["Ambaraambaravatiyo","Ambara-Ambaravatiya,"],["Āḷakamandā nāma rājadhānī","and the royal capital named Āḷakamandā."]],[["Kuverassa kho pana mārisa mahārājassa","And the great king Kuvera, dear sir,"],["Visāṇā nāma rājadhānī","has a royal capital named Visāṇā;"],["Tasmā kuvero mahārājā","therefore the great king Kuvera"],["Vessavaṇo’ti pavuccati","is called Vessavaṇa."]],[["Paccesanto pakāsenti","Each making his own inquiries, they report to him:"],["Tatolā","Tatolā,"],["Tattalā","Tattalā,"],["Tatotalā","Tatotalā,"],["Ojasi","Ojasi,"],["Tejasi","Tejasi,"],["Tatojasi","Tatojasi,"],["Sūro rājā","Sūra, Rājā,"],["Ariṭṭho nemi","Ariṭṭha and Nemi."]],[["Rahado pi tattha","There is also a lake there"],["Dharaṇī nāma","named Dharaṇī,"],["Yato meghā pavassanti","from which the clouds rain down,"],["Vassā yato patāyanti","from which the rains spread out."],["Sabhāpi tattha","There is also a hall there"],["Bhagalavatī nāma","named Bhagalavatī,"],["Yattha yakkhā payirupāsanti","where the yakkhas gather in attendance."]],[["Tattha niccaphalā rukkhā","There the trees are ever in fruit,"],["Nānādijagaṇāyutā","thronged with flocks of many kinds of birds,"],["Mayurakoñcābhirudā","resounding with the cries of peacocks and herons"],["Kokilādīhi vagguhi","and with the sweet song of cuckoos and others."]],[["Jīvajīvakasaddettha","Here is the call of the jīvaṃjīvaka birds,"],["Atho uṭṭhavacittakā","and also the oṭṭhavacittaka birds,"],["Kukutthakā","the jungle fowl,"],["Kuḷīrakā","the golden crabs,"],["Vane pokkharasātakā","and in the wood the pokkharasātaka birds."]],[["Sukasālikasaddettha","Here is the sound of parrots and mynahs,"],["Daṇḍamānavakāni ca","and the daṇḍamāṇavaka birds too."],["Sobhati sabbakālaṃ sā","It is beautiful at all times,"],["Kuveranalinī sadā","Kuvera's lotus pond, always."]],[["Ito","From here"],["Sā uttarā disā","that is the northern quarter,"],["Iti naṃ ācikkhatī jano","so the people call it,"],["Yaṃ disaṃ abhipāleti","the quarter that is guarded by"],["Mahārājā yasassi so","that glorious great king."]],[["Yakkhānaṃ ādhipati","Lord of the yakkhas,"],["Kuvero iti nāmaso","Kuvera is his name."],["Ramati naccagītehi","He delights in dance and song,"],["Yakkheheva purakkhato","honoured by the yakkhas."]],[["Puttā pi tassa bahavo","He has many sons too,"],["Ekanāmā’ti me sutaṃ","all of one name, so I have heard:"],["Asītiṃ dasa eko ca","eighty and ten and one,"],["Indanāmā","Inda by name,"],["Mahabbalā","of mighty strength."]],[["Te cāpi","They too,"],["Buddhaṃ disvāna","having seen the Buddha,"],["Buddhaṃ ādiccabandhunaṃ","the Buddha, kinsman of the sun,"],["Dūrato’va namassanti","pay homage from afar"],["Mahantaṃ vītasāradaṃ","to the great one, free from fear:"],["Namo te purisājañña","\"Homage to you, thoroughbred among men!"],["Namo te purisuttama","Homage to you, supreme among men!"]],[["Kusalena samekkhasi","With skilful insight you look upon us;"],["Amanussāpi taṃ vandanti","even the non-humans worship you.\""],["Sutaṃ netaṃ abhiṇhaso","This we have heard again and again,"],["Tasmā evaṃ vademase","therefore we speak thus:"]],[["Jinaṃ vandatha gotamaṃ","\"Do you worship Gotama the Conqueror?\""],["Jinaṃ vandāma gotamaṃ","\"We worship Gotama the Conqueror;"],["Vijjācaraṇasampannaṃ","perfect in knowledge and conduct,"],["Buddhaṃ vandāma gotamanti","the Buddha Gotama we worship.\""]],[["Ayaṃ kho sā mārisa","This, dear sir,"],["Āṭānāṭiyā rakkhā","is the Āṭānāṭiya protection"]],[["Bhikkhūnaṃ","for the monks,"],["Bhikkhunīnaṃ","the nuns,"],["Upāsakānaṃ","the laymen"],["Upāsikānaṃ","and the laywomen,"],["Guttiyā","for their guarding,"],["Rakkhāya","for their protection,"],["Avihiṃsāya","for their freedom from harm,"],["Phāsuvihārāyāti","and for their dwelling in comfort."]],[["Yassa kassaci mārisa","Whoever, dear sir,"],["Bhikkhussa vā","whether monk"],["Bhikkhuniyā vā","or nun,"],["Upāsakassa vā","layman"],["Upāsikāya vā","or laywoman,"],["Ayaṃ āṭānāṭiyā rakkhā","this Āṭānāṭiya protection"],["Suggahitā bhavissati","has well learnt"],["Samattā pariyāputā","and completely mastered,"]],[["Tañce","if that person"],["Amanusso","any non-human,"],["Yakkho vā","whether a male yakkha"],["Yakkhinī vā","or a female yakkha,"],["Yakkhapotako vā","a yakkha boy"],["Yakkhapotikā vā","or a yakkha girl,"],["Yakkhamahāmatto vā","a yakkha chief minister,"],["Yakkhapārisajjo vā","a yakkha councillor"],["Yakkhapacāro vā","or a yakkha attendant;"]],[["Gandhabbo vā","whether a male gandhabba"],["Gandhabbī vā","or a female gandhabba,"],["Gandhabbapotako vā","a gandhabba boy"],["Gandhabbapotikā vā","or a gandhabba girl,"],["Gandhabbamahāmatto vā","a gandhabba chief minister,"],["Gandhabbapārisajjo vā","a gandhabba councillor"],["Gandhabbapacāro vā","or a gandhabba attendant;"]],[["Kumbhaṇḍo vā","whether a male kumbhaṇḍa"],["Kumbhaṇḍī vā","or a female kumbhaṇḍa,"],["Kumbhaṇḍapotako vā","a kumbhaṇḍa boy"],["Kumbhaṇḍapotikā vā","or a kumbhaṇḍa girl,"],["Kumbhaṇḍamahāmatto vā","a kumbhaṇḍa chief minister,"],["Kumbhaṇḍapārisajjo vā","a kumbhaṇḍa councillor"],["Kumbhaṇḍapacāro vā","or a kumbhaṇḍa attendant;"]],[["Nāgo vā","whether a male nāga"],["Nāginī vā","or a female nāga,"],["Nāgapotako vā","a nāga boy"],["Nāgapotikā vā","or a nāga girl,"],["Nāgamahāmatto vā","a nāga chief minister,"],["Nāgapārisajjo vā","a nāga councillor"],["Nāgapacāro vā","or a nāga attendant;"]],[["Paduṭṭhacitto","with a mind of ill will,"],["Bhikkhuṃ vā","a monk"],["Bhikkhuniṃ vā","or a nun,"],["Upāsakaṃ vā","a layman"],["Upāsikaṃ vā","or a laywoman,"],["Paduṭṭhacitto","with a mind of ill will,"]],[["Gacchantaṃ vā anugaccheyya","should follow them as they walk,"],["Ṭhitaṃ vā upatiṭṭheyya","stand near them as they stand,"],["Nisinnaṃ vā upanisīdeyya","sit near them as they sit,"],["Nipannaṃ vā upanipajjeyya","or lie near them as they lie down,"]],[["Na me so mārisa","then, dear sir, from me that"],["Amanusso","non-human"],["Labheyya","would not receive,"],["Gāmesu vā","in villages"],["Nigamesu vā","or in towns,"],["Sakkāraṃ vā","hospitality"],["Garukāraṃ vā","or respect."]],[["Na me so mārisa","Nor, dear sir, from me would that"],["Amanusso","non-human"],["Labheyya","receive,"],["Āḷakamandāya nāma rājadhāniyā","in the royal capital named Āḷakamandā,"],["Vatthuṃ vā","a site"],["Vāsaṃ vā","or a dwelling."]],[["Na me so mārisa","Nor, dear sir, from me would that"],["Amanusso","non-human"],["Labheyya","get leave"],["Yakkhānaṃ samitiṃ","to the assembly of the yakkhas"],["Gantuṃ","to go."]],[["Apissu naṃ mārisa","Moreover, dear sir, him"],["Amanussā","the non-humans"],["Anavayhampi naṃ kareyyuṃ","would bar from taking a bride"],["Avivayhaṃ","and from giving one in marriage."]],[["Apissu naṃ mārisa","Moreover, dear sir, him"],["Amanussā","the non-humans"],["Attāhi paripuṇṇāhi","with personal and thorough"],["Paribhāsāhi","insults"],["Paribhāseyyuṃ","would abuse."]],[["Apissu naṃ mārisa","Moreover, dear sir,"],["Amanussā","the non-humans"],["Rittampi’ssa pattaṃ","an empty bowl"],["Sīse nikkujjeyyuṃ","would turn upside down over his head."]],[["Apissu naṃ mārisa","Moreover, dear sir,"],["Amanussā","the non-humans"],["Sattadhāpi’ssa muddhaṃ","his head into seven pieces"],["Phāleyyuṃ","would split."]],[["Santi hi mārisa","For there are, dear sir,"],["Amanussā","non-humans"],["Caṇḍā","who are fierce,"],["Ruddhā","cruel"],["Rabhasā","and violent."]],[["Te neva mahārājānaṃ","Neither to the Great Kings"],["Ādiyanti","do they pay heed,"],["Na mahārājānaṃ purisakānaṃ","nor to the Great Kings' men"],["Ādiyanti","do they pay heed,"],["Na mahārājānaṃ purisakānaṃ purisakānaṃ","nor to the men of the Great Kings' men"],["Ādiyanti","do they pay heed."]],[["Te kho te mārisa","These, dear sir,"],["Amanussā","non-humans"],["Mahārājānaṃ","of the Great Kings"],["Avaruddhā nāma vuccanti","are called rebels."]],[["Seyyathāpi mārisa","Just as, dear sir,"],["Rañño māgadhassa vijite","in the realm of the king of Magadha"],["Mahācorā","there are great bandits:"]],[["Te neva rañño māgadhassa","Neither to the king of Magadha"],["Ādiyanti","do they pay heed,"],["Na rañño māgadhassa purisakānaṃ","nor to the king of Magadha's men"],["Ādiyanti","do they pay heed,"],["Na rañño māgadhassa purisakānaṃ purisakānaṃ","nor to the men of the king of Magadha's men"],["Ādiyanti","do they pay heed."]],[["Te kho te mārisa","These, dear sir,"],["Mahācorā","great bandits"],["Rañño māgadhassa","of the king of Magadha"],["Avaruddhā nāma vuccanti","are called rebels."]],[["Evameva kho mārisa","Even so, dear sir,"],["Santi hi","there are"],["Amanussā","non-humans"],["Caṇḍā","who are fierce,"],["Ruddhā","cruel"],["Rabhasā","and violent."]],[["Te neva mahārājānaṃ","Neither to the Great Kings"],["Ādiyanti","do they pay heed,"],["Na mahārājānaṃ purisakānaṃ","nor to the Great Kings' men"],["Ādiyanti","do they pay heed,"],["Na mahārājānaṃ purisakānaṃ purisakānaṃ","nor to the men of the Great Kings' men"],["Ādiyanti","do they pay heed."]],[["Te kho te mārisa","These, dear sir,"],["Amanussā","non-humans"],["Mahārājānaṃ","of the Great Kings"],["Avaruddhā nāma vuccanti","are called rebels."]],[["Yo hi koci mārisa","If any, dear sir,"],["Amanusso","non-human,"],["Yakkho vā","whether a male yakkha"],["Yakkhinī vā","or a female yakkha,"],["Yakkhapotako vā","a yakkha boy"],["Yakkhapotikā vā","or a yakkha girl,"],["Yakkhamahāmatto vā","a yakkha chief minister,"],["Yakkhapārisajjo vā","a yakkha councillor"],["Yakkhapacāro vā","or a yakkha attendant;"]],[["Gandhabbo vā","whether a male gandhabba"],["Gandhabbī vā","or a female gandhabba,"],["Gandhabbapotako vā","a gandhabba boy"],["Gandhabbapotikā vā","or a gandhabba girl,"],["Gandhabbamahāmatto vā","a gandhabba chief minister,"],["Gandhabbapārisajjo vā","a gandhabba councillor"],["Gandhabbapacāro vā","or a gandhabba attendant;"]],[["Kumbhaṇḍo vā","whether a male kumbhaṇḍa"],["Kumbhaṇḍī vā","or a female kumbhaṇḍa,"],["Kumbhaṇḍapotako vā","a kumbhaṇḍa boy"],["Kumbhaṇḍapotikā vā","or a kumbhaṇḍa girl,"],["Kumbhaṇḍamahāmatto vā","a kumbhaṇḍa chief minister,"],["Kumbhaṇḍapārisajjo vā","a kumbhaṇḍa councillor"],["Kumbhaṇḍapacāro vā","or a kumbhaṇḍa attendant;"]],[["Nāgo vā","whether a male nāga"],["Nāginī vā","or a female nāga,"],["Nāgapotako vā","a nāga boy"],["Nāgapotikā vā","or a nāga girl,"],["Nāgamahāmatto vā","a nāga chief minister,"],["Nāgapārisajjo vā","a nāga councillor"],["Nāgapacāro vā","or a nāga attendant;"]],[["Paduṭṭhacitto","with a mind of ill will,"],["Bhikkhuṃ vā","a monk"],["Bhikkhuniṃ vā","or a nun,"],["Upāsakaṃ vā","a layman"],["Upāsikaṃ vā","or a laywoman,"]],[["Gacchantaṃ vā anugaccheyya","should follow them as they walk,"],["Ṭhitaṃ vā upatiṭṭheyya","stand near them as they stand,"],["Nisinnaṃ vā upanisīdeyya","sit near them as they sit,"],["Nippannaṃ vā upanipajjeyya","or lie near them as they lie down,"]],[["Imesaṃ yakkhānaṃ","To these yakkhas,"],["Mahāyakkhānaṃ","great yakkhas,"],["Senāpatīnaṃ","generals"],["Mahāsenāpatīnaṃ","and great generals,"],["Ujjhāpetabbaṃ","one should complain,"],["Vikkanditabbaṃ","cry out"],["Viravitabbaṃ","and call aloud:"]],[["Ayaṃ yakkho gaṇhāti","\"This yakkha is seizing me,"],["Ayaṃ yakkho āvisati","this yakkha is possessing me,"],["Ayaṃ yakkho heṭheti","this yakkha is harassing me,"],["Ayaṃ yakkho viheṭheti","this yakkha is tormenting me,"],["Ayaṃ yakkho hiṃsati","this yakkha is hurting me,"],["Ayaṃ yakkho vihiṃsati","this yakkha is injuring me,"],["Ayaṃ yakkho na muñcatī”ti","this yakkha will not let me go!\""]],[["Katamesaṃ yakkhānaṃ","To which yakkhas,"],["Mahāyakkhānaṃ","great yakkhas,"],["Senāpatīnaṃ","generals"],["Mahāsenāpatīnaṃ","and great generals?"]],[["Indo somo varuṇo ca","Inda, Soma and Varuṇa,"],["Bhāradvājo pajāpati","Bhāradvāja, Pajāpati,"],["Candano kāmaseṭṭho ca","Candana and Kāmaseṭṭha,"],["Kinnighaṇḍu nighaṇḍu ca","Kinnughaṇḍu and Nighaṇḍu;"]],[["Panādo opamañño ca","Panāda and Opamañña,"],["Devasūto ca mātali","Devasūta and Mātali,"],["Cittaseno ca gandhabbo","Cittasena the gandhabba,"],["Naḷo rājā janesabho","Naḷa, Rājā, Janesabha;"]],[["Sātāgiro hemavato","Sātāgira, Hemavata,"],["Puṇṇako karatiyo guḷo","Puṇṇaka, Karatiya, Guḷa,"],["Sīvako mucalindo ca","Sīvaka and Mucalinda,"],["Vessāmitto yugandharo","Vessāmitta, Yugandhara;"]],[["Gopālo supparodho ca","Gopāla and Suppagedha,"],["Hirinetti ca mandiyo","Hiri, Netti and Mandiya,"],["Pañcālacaṇḍo āḷavako","Pañcālacaṇḍa, Āḷavaka,"],["Pajjanno sumano","Pajjunna, Sumana,"],["Sumukho dadhimukho","Sumukha, Dadhimukha,"],["Maṇi mānī caro dīgho","Maṇi, Māṇi, Cara, Dīgha,"],["Atho serissako saha","and together with them Serissaka."]],[["Imesaṃ yakkhānaṃ","To these yakkhas,"],["Mahāyakkhānaṃ","great yakkhas,"],["Senāpatīnaṃ","generals"],["Mahāsenāpatīnaṃ","and great generals,"],["Ujjhāpetabbaṃ","one should complain,"],["Vikkanditabbaṃ","cry out"],["Viravitabbaṃ","and call aloud:"]],[["Ayaṃ yakkho gaṇhāti","\"This yakkha is seizing me,"],["Ayaṃ yakkho āvisati","this yakkha is possessing me,"],["Ayaṃ yakkho heṭheti","this yakkha is harassing me,"],["Ayaṃ yakkho viheṭheti","this yakkha is tormenting me,"],["Ayaṃ yakkho hiṃsati","this yakkha is hurting me,"],["Ayaṃ yakkho vihiṃsati","this yakkha is injuring me,"],["Ayaṃ yakkho na muñcatī ti","this yakkha will not let me go!\""]],[["Ayaṃ kho sā mārisa","This, dear sir,"],["Āṭānāṭiyā rakkhā","is the Āṭānāṭiya protection"]],[["Bhikkhūnaṃ","for the monks,"],["Bhikkhunīnaṃ","the nuns,"],["Upāsakānaṃ","the laymen"],["Upāsikānaṃ","and the laywomen,"],["Guttiyā","for their guarding,"],["Rakkhāya","for their protection,"],["Avihiṃsāya","for their freedom from harm,"],["Phāsuvihārāyā ti","and for their dwelling in comfort."]],[["Handa ca dāni mayaṃ mārisa","Well now, dear sir, we"],["Gacchāma","must go;"],["Bahukiccā mayaṃ","we have many duties,"],["Bahukaraṇīyā’ti","much to do.\""]],[["Yassa dāni tumhe mahārājāno","\"Great Kings, for whatever you now"],["Kālaṃ maññathā’ti","think it is the time.\""]],[["Atha kho bhikkhave","Then, monks,"],["Cattāro mahārājāno","the Four Great Kings"],["Uṭṭhāyāsanā","rose from their seats,"],["Maṃ abhivādetvā","bowed to me,"],["Padakkhiṇaṃ katvā","circled me keeping me on their right,"],["Tatthevantaradhāyiṃsu","and vanished right there."]],[["Te’pi kho bhikkhave yakkhā","And those yakkhas too, monks,"],["Uṭṭhāyāsanā","rose from their seats."],["Appekacce","Some"],["Maṃ abhivādetvā","bowed to me,"],["Padakkhiṇaṃ katvā","circled me keeping me on their right,"],["Tatthevantaradhāyiṃsu","and vanished right there."]],[["Appekacce","Some"],["Mayā saddhiṃ","with me"],["Sammodiṃsu","exchanged greetings,"],["Sammodanīyaṃ kathaṃ","and after pleasant talk,"],["Sārāṇīyaṃ","courteous and memorable,"],["Vītisāretvā","had been concluded,"],["Tatthevantaradhāyiṃsu","vanished right there."]],[["Appekacce","Some,"],["Yenāhaṃ","towards where I was"],["Tenañjalimpaṇāmetvā","raising their joined palms,"],["Tatthevantaradhāyiṃsu","vanished right there."]],[["Appekacce","Some,"],["Nāmagottaṃ sāvetvā","announcing their name and clan,"],["Tatthevantaradhāyiṃsu","vanished right there."],["Appekacce","Some,"],["Tuṇhībhūtā","remaining silent,"],["Tatthevantaradhāyiṃsu’ti","vanished right there."]],[["Uggaṇhātha bhikkhave","Learn, monks,"],["Āṭānāṭiyaṃ rakkhaṃ","the Āṭānāṭiya protection."],["Pariyāpuṇātha bhikkhave","Master, monks,"],["Āṭānāṭiyaṃ rakkhaṃ","the Āṭānāṭiya protection."],["Dhāretha bhikkhave","Bear in mind, monks,"],["Āṭānāṭiyaṃ rakkhaṃ","the Āṭānāṭiya protection."]],[["Atthasaṃhitā bhikkhave","It is beneficial, monks,"],["Āṭānāṭiyā rakkhā","this Āṭānāṭiya protection,"]],[["Bhikkhūnaṃ","for the monks,"],["Bhikkhunīnaṃ","the nuns,"],["Upāsakānaṃ","the laymen"],["Upāsikānaṃ","and the laywomen,"],["Guttiyā","for their guarding,"],["Rakkhāya","for their protection,"],["Avihiṃsāya","for their freedom from harm,"],["Phāsuvihārāyā ti","and for their dwelling in comfort.\""]],[["Idamavoca bhagavā","This is what the Blessed One said."],["Attamanā te bhikkhū","Delighted, those monks"],["Bhagavato bhāsitaṃ","in the Blessed One's words"],["Abhinandunti","rejoiced."]]]}