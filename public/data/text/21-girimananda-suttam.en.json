ikkhati","reflects thus:"]],[["Etaṃ santaṃ","'This is peaceful,"],["Etaṃ paṇītaṃ","this is sublime,"],["Yadidaṃ","that is to say,"],["Sabba saṃkhāra samatho","the calming of all formations,"]],[["Sabbupadhipaṭinissago","the relinquishing of all attachments,"],["Taṇhakkhayo","the destruction of craving,"],["Virāgo","dispassion,"],["Nibbāṇātti","Nibbana.'"]],[["Ayaṃ vuccati ānanda virāga saññā","This is called, Ananda, the perception of dispassion."]],[["Katamā ca","And what,"],["Ānanda","Ananda,"],["Nirodha saññā","is the perception of cessation?"]],[["Idha ānanda","Here, Ananda,"],["Bhikkhu","a monk"],["Araññagato vā","having gone to a forest,"],["Rukkhamūlagato vā","or to the foot of a tree,"],["Suññāgāragato vā","or to an empty hut,"],["Iti paṭisaṃcikkhati","reflects thus:"]],[["Etaṃ santaṃ","'This is peaceful,"],["Etaṃ paṇītaṃ","this is sublime,"],["Yaddiṃ","that is to say,"],["Sabba saṃkhāra samatho","the calming of all formations,"]],[["Sabbupadhipaṭinissaggo","the relinquishing of all attachments,"],["Taṇhakkhayo","the destruction of craving,"],["Nirodho","cessation,"],["Nibbāṇanti","Nibbana.'"]],[["Ayaṃ vuccati ānanda nirodha saññā","This is called, Ananda, the perception of cessation."]],[["Katamā ca","And what,"],["Ānanda","Ananda,"],["Sabba loke anabhirata saññā","is the perception of non-delight in the entire world?"]],[["Idha ānanda","Here, Ananda,"],["Bhikkhu","a monk"],["Ye loke upāyūpādānā","whatever engagements and clingings there are in the world,"]],[["Cetaso","mental"],["Adhiṭṭhānābhinivesā","standpoints and adherences,"],["Anusayo","and underlying tendencies,"],["Te pajahanto","abandoning them,"],["Viramati na upādinto","he abstains and does not cling."]],[["Ayaṃ vuccati ānanda sabba loke anabhirata saññā","This is called, Ananda, the perception of non-delight in the entire world."]],[["Katamā ca","And what,"],["Ānanda","Ananda,"],["Sabba saṃkhāresu","in all formations"],["Anicca saññā","is the perception of impermanence?"]],[["Idha ānanda","Here, Ananda,"],["Bhikkhu","a monk"],["Sabba saṃkhārehi","by all formations"],["Aṭṭiyati","is troubled,"],["Harāyati","is ashamed,"],["Jigucchati","and is disgusted."]],[["Ayaṃ vuccati ānanda sabba saṃkhāresu anicca saññā","This is called, Ananda, the perception of impermanence in all formations."]],[["Katamā ca","And what,"],["Ānanda","Ananda,"],["Ānāpāna sati","is mindfulness of breathing?"]],[["Idha ānanda","Here, Ananda,"],["Bhikkhu","a monk"],["Araññagato vā","having gone to a forest,"],["Rukkhamūlagato vā","or to the foot of a tree,"],["Suññāgāragato vā","or to an empty hut,"],["Nisidati","sits down,"],["Pallakaṃ ābhujitvā","having folded his legs crosswise,"]],[["Ujuṃ kāyaṃ paṇīdhāya","keeping his body erect,"],["Parimukhaṃ satiṃ upaṭṭhapetvā","and setting mindfulness to the forefront."]],[["So","He"],["Satova","mindfully"],["Assa sati","breathes in;"],["Sato","mindfully"],["Passa sati","breathes out."]],[["Dīghaṃ vā","Long"],["Assa santo","while breathing in,"],["Dīghaṃ assa sāmīti pajanāti","he discerns: 'I breathe in long.'"]],[["Dīghaṃ vā passa santo","Or long while breathing out,"],["Dīghaṃ passa sāmiti pajanāti","he discerns: 'I breathe out long.'"]],[["Rassaṃ vā assa santo","Short while breathing in,"],["Rassaṃ assa sāmīti pajanāti","he discerns: 'I breathe in short.'"]],[["Rassaṃ vā passa santo","Or short while breathing out,"],["Rassaṃ passasāmī’ti pajanāti","he discerns: 'I breathe out short.'"]],[["Sabbakāya paṭisaṃvedī","'Experiencing the whole body,"],["Assa sissāmīti","I will breathe in,'"],["Sikkhati","he trains himself."]],[["Sabbakāya paṭisaṃvedī","'Experiencing the whole body,"],["Passa sissāmīti","I will breathe out,'"],["Sikkhati","he trains himself."]],[["Passaṃbhayaṃ kāya saṃkhāraṃ","'Tranquilizing the bodily formation,"],["Assasāmi’ti","I will breathe in,'"],["Sikkhati","he trains himself."]],[["Passaṃbhayaṃ kāya saṃkhāraṃ","'Tranquilizing the bodily formation,"],["Passasissāmi’ti","I will breathe out,'"],["Sikkhati","he trains himself."]],