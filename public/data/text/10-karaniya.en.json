{"groups":[[["Karaṇīya metta suttaṃ","The Discourse on Loving-Kindness."]],[["Karaṇīyamatthakusalena","This is what should be done by one skilled in good,"],["Yaṃ taṃ","who wishes to"],["Santaṃ padaṃ","attain the state of peace,"],["Abhisamecca","having comprehended it:"]],[["Sakko","One must be able,"],["Uju ca","upright,"],["Sūjū ca","thoroughly upright,"],["Suvacocassa","amenable to instruction,"],["Mudu","gentle,"],["Anatimāni","and not arrogant."]],[["Santussako ca","Contented,"],["Subharo ca","easily supported,"],["Appa kicco ca","with few duties,"],["Sallahuka vutti","and living lightly,"]],[["Santindriyo ca","with peaceful senses,"],["Nipako ca","wise,"],["Appa gabbho","courteous,"],["Kulesū ananugiddho","and not greedily attached to families."]],[["Naca khuddaṃ samācare","One should not commit even the slightest wrong"],["Kiñci yena","for which"],["Viññupare","other wise people"],["Upavadeyyuṃ","might reprove."]],[["Sukhino vā","May they be happy"],["Khemino hontu","and secure."],["Sabbe sattā","May all beings"],["Bhavantu sukhitattā","be happy at heart."]],[["Ye keci","Whatever"],["Pāṇabhūtatthi","living beings there may be,"],["Tasā vā","whether they are feeble"],["Thāvarā vā","or strong,"],["Anavasesā","without exception,"]],[["Dīghā vā","whether long,"],["Ye","those who are"],["Mahantā vā","large,"],["Majjhimā","medium,"],["Rassakāṇukathūlā","short, fine, or gross,"]],[["Diṭṭhā vā","whether seen"],["Yeva addiṭṭhā","or unseen,"],["Yeca dūre vasanti","those dwelling far"],["Avidūre","or near,"]],[["Bhūtā vā","those who are born"],["Sambhavesī vā","or seeking birth:"],["Sabbe sattā","may all beings"],["Bhavantu","be"],["Sukhitattā","happy at heart."]],[["Na","Let not"],["Paro","one"],["Paraṃ","another"],["Nikubbetha","deceive,"],["Nātimaññetha","nor despise"],["Katthaci","anywhere,"],["Naṃ kañci","anyone at all."]],[["Khyārosanā","Out of physical or verbal anger"],["Paṭighasañañā","or thoughts of ill-will,"],["Nāññamaññassa","to each other"],["Dukkhamiccheyya","one should not wish suffering."]],[["Mātā","Just as a mother"],["Yathā","would"],["Niyaṃ puttaṃ","her own child,"],["Āyusā","with her life,"],["Eka puttamanurakkhe","protect her only child,"]],[["Evampi","so too"],["Sabba bhutesu","towards all beings"],["Mānasaṃ","a mind of loving-kindness"],["Bhāvaye","one should cultivate,"],["Aparimāṇaṃ","that is boundless."]],[["Mettaṃ ca","With loving-kindness"],["Sabba lokasmiṃ","towards the entire world,"],["Mānasaṃ bhāvaye","one should cultivate a mind"],["Aparimāṇaṃ","that is boundless,"]],[["Uddhaṃ ca","above,"],["Adho ca","below,"],["Tiriyañ ca","and across,"],["Asambādhaṃ","unobstructed,"],["Averaṃ","free from hatred,"],["Asapattaṃ","and free from enmity."]],[["Tiṭṭhaṃ","Whether standing,"],["Caraṃ","walking,"],["Nisinno vā","seated,"],["Sayāno vā","or lying down,"],["Yāvatassa vigatamiddho","as long as one is awake,"]],[["Etaṃ satiṃ","this mindfulness"],["Adhiṭṭheyya","one should resolve upon."],["Brahmametaṃ vihāraṃ","This is the divine abiding,"],["Idhamāhu","thus it is said here."]],[["Diṭṭhiñ ca","False views"],["Anupagamma","not falling into,"],["Sīlavā","being virtuous"],["Dassanena sampanno","and endowed with insight,"]],[["Kāmesū","in sensual pleasures"],["Vineyya gedhaṃ","having removed greed,"],["Nahi jātu","surely he does not"],["Gabbhaseyyaṃ","to lie in a womb"],["Punaretī ti","come again."]]]}