{"groups":[[["Āḷavaka suttaṃ","The Discourse to Āḷavaka"]],[["Evaṃ sutaṃ","Thus have I heard."],["Ekaṃ samayaṃ bhagavā","On one occasion, the Blessed One"]],[["Āḷaviyaṃ viharati","was dwelling at Āḷavī,"],["Āḷavakassa yakkhassa bhavane","in the abode of the yakkha Āḷavaka."]],[["Atha kho āḷavako yakkho","Then the yakkha Āḷavaka"],["Yena bhagavā tena upasaṃkami upasaṃkamitvā","approached the Blessed One. Having approached,"],["Bhagavantaṃ bhagavantaṃ etadavoca","he said this to the Blessed One:"]],[["Nikkhama samaṇāti","\"Get out, ascetic!\""],["Sādhāvusoti bhagavā nikkhami","\"Very well, friend,\" said the Blessed One, and he went out."],["Pavisa samaṇāti","\"Come in, ascetic!\""],["Sādhāvusoti bhagavā pāvisi","\"Very well, friend,\" said the Blessed One, and he went in."]],[["Dutiyampi kho āḷavako yakkho","For a second time, the yakkha Āḷavaka"],["Bhagavantaṃ etadavoca","said this to the Blessed One:"]],[["Nikkhama samaṇāti","\"Get out, ascetic!\""],["Sādhāvusoti bhagavā nikkhami","\"Very well, friend,\" said the Blessed One, and he went out."],["Pavisa samaṇāti","\"Come in, ascetic!\""],["Sādhāvusoti bhagavā pāvisi","\"Very well, friend,\" said the Blessed One, and he went in."]],[["Tatiyampi kho āḷavako yakkho bhagavantaṃ etadavoca","For a third time, the yakkha Āḷavaka said this to the Blessed One:"]],[["Nikkhama samaṇāti","\"Get out, ascetic!\""],["Sādhāvusoti bhagavā nikkhami","\"Very well, friend,\" said the Blessed One, and he went out."],["Pavisa samaṇāti","\"Come in, ascetic!\""],["Sādhāvusoti bhagavā pāvisi","\"Very well, friend,\" said the Blessed One, and he went in."]],[["Catutthampi kho āḷavako yakkho bhagavantaṃ etadavoca","For a fourth time, the yakkha Āḷavaka said this to the Blessed One:"]],[["Nikkhama samaṇāti","\"Get out, ascetic!\""],["Na khvāhaṃ āvuso nikkhamissāmi","\"I will not go out, friend.\""],["Yaṃ te karaṇīyaṃ","\"Whatever you have to do,\""],["Taṃ karohīti","\"do it.\""]],[["Pañhaṃ taṃ samaṇa","\"Ascetic, a question to you"],["Pucchissāmi","I will ask."],["Sace me na byākarissasi","If you do not answer me,"],["Cittaṃ vā te khipissāmi","I will overthrow your mind,"],["Hadayaṃ vā te phālessāmi","or split your heart,"],["Pādesu vā gahetvā pāragaṅgāya khipissāmīti","or, grabbing you by the feet, I will hurl you across the Ganges.\""]],[["Na khvāhaṃ taṃ āvuso passāmi","\"Friend, I do not see anyone capable of doing that.\""]],[["Api ca tvaṃ āvuso","\"Nevertheless, friend,\""],["Puccha yadākaṅkhasīti","\"ask whatever you desire.\""],["Atha kho āḷavako yakkho","Then the yakkha Āḷavaka"],["Bhagavantaṃ gāthāya ajjhabhāsi","addressed the Blessed One in a stanza:"]],[["Kiṃ sūdha vittaṃ","\"What here in this world"],["Purisassa seṭṭhaṃ","is a person's best wealth?"],["Kiṃ su suciṇṇaṃ","What, when well practiced,"],["Sukhamāvahāti","brings happiness?"],["Kiṃ su have","What indeed is"],["Sādutaraṃ rasānaṃ","the sweetest of tastes?"],["Kathaṃ jīvī","Living in what manner"],["Jīvitamāhu seṭṭhanti?","do they call life the best?\""]],[["Saddhīdha vittaṃ purisassa seṭṭhaṃ","\"Faith is a person's best wealth here."],["Dhammo suciṇṇo","The Dhamma, when well practiced,"],["Sukhamāvahāti","brings happiness."],["Saccaṃ have sādutaraṃ rasānaṃ","Truth is indeed the sweetest of tastes."],["Paññājīviṃ","Living with wisdom"],["Jīvitamāhu seṭṭhanti","is what they call the best life.\""]],[["Kathaṃ su tarati oghaṃ","\"How does one cross the flood?"],["Kathaṃsu tarati aṇṇavaṃ","How does one cross the ocean?"],["Kathaṃ su dukkhaṃ acceti","How does one overcome suffering?"],["Kathaṃ su parisujjhatīti","How is one purified?\""]],[["Saddhāya tarati oghaṃ","\"By faith one crosses the flood."],["Appamādena aṇṇavaṃ","By diligence one crosses the ocean."],["Viriyena dukkhaṃ acceti","By energy one overcomes suffering."],["Paññāya parisujjhatīti","By wisdom one is purified.\""]],[["Kathaṃ su labhate paññaṃ","\"How does one gain wisdom?"],["Kathaṃsu vindate dhanaṃ","How does one find wealth?"],["Kathaṃ su kittiṃ pappoti","How does one achieve fame?"],["Kathaṃ mittāni ganthati","How does one bind friends?"],["Asmā lokā paraṃ lokaṃ","Passing from this world to the next,"],["Kathaṃ pecca na socatīti?","how does one not grieve after passing away?\""]],[["Saddahāno arahataṃ","\"Having faith in the Arahants (and their Dhamma)"]],[["Patirūpakārī dhuravā","Acting appropriately, being steadfast,"],["Uṭṭhātā vindate dhanaṃ","and industrious, one finds wealth."],["Saccena kittiṃ pappoti","Through truthfulness, one achieves fame."],["Dadaṃ mittāni ganthati","By giving, one binds friends."]],[["Yassete caturo dhammā","If one has these four virtues,"],["Saddhassa gharamesino","for a faithful householder:"],["Saccaṃ dhammo","truthfulness, righteousness,"],["Dhiti cāgo","courage, and generosity,"],["Sa ce pecca na socati","he indeed does not grieve after passing away."],["Asmā lokā paraṃ lokaṃ","Passing from this world to the next,"],["Evaṃ pecca na socatīti","thus he does not grieve after passing away.\""]],[["Iṅgha aññepi pucchassu","\"Come now, ask others as well\""]],[["Kathaṃ nu dāni puccheyyaṃ","\"Why should I now ask (others)?\""]],[["Atthāya vata me buddho vāsāyāḷavimāgamā","\"Indeed, it was for my benefit that the Buddha came to dwell at Āḷavī."],["So’haṃ ajja pajānāmi yattha dinnaṃ mahapphalaṃ","Today I know where a gift given bears great fruit."]],[["So ahaṃ vicarissāmi","I will wander\""]],[["Bhagavantaṃ","to the Blessed One"],["Etada voca","he said this:"],["Abhikkantaṃ","\"Excellent,"],["Bho gotama","O Gotama,"],["Abhikkantaṃ ho gotama","Excellent, O Gotama.\""]],[["Seyyathāpi","\"Just as if,"],["Bho gotama","O Gotama,"],["Nikkujjitaṃ vā","what was overturned"],["Ukkujjye","were set upright,"],["Paṭicchannaṃ","or what was hidden"],["Vivareyya vā","were revealed,"],["Muḷhassa","to one who is lost"],["Maggaṃ vā","the path"],["Āvikkheyya","were pointed out,"]],[["Andhakāre","in the darkness"],["Telapajjotaṃ dhāreyya vā","or were to hold an oil lamp,"],["Cakkhumato rūpānidakkhinti","thinking, 'those with eyes will see forms';"],["Evaṃ eva","in the exact same way,"],["Hotā gotamena","by the Master Gotama,"],["Aneka pariyāyena","in many ways,"],["Dhammo pakāsito","the Dhamma has been made clear."]],[["Esā’haṃ","I, myself,"],["Bhavantaṃ gotamaṃ","to the Master Gotama"],["Saraṇaṃ gacchāmi","go for refuge,"],["Dhammañca","and to the Dhamma,"],["Bhikkhu saṃghañca","and to the Sangha of monks."],["Upāsitaṃ","as a lay follower."],["Maṃ","me"],["Havaṃ gotamo","May the Master Gotama"],["Dhāretu iti","remember."],["Ajjatagge","From today onwards,"],["Pāṇupetaṃ","for as long as life lasts,"],["Saraṇaṃ gataṃ","as one who has gone for refuge.\""]]]}