of feeling subject to clinging,"],["Saññupādānakkhandho","the aggregate of perception subject to clinging,"],["Saṅkhārūpādānakkhandho","the aggregate of formations subject to clinging,"],["Viññāṇupādānakkhandho","the aggregate of consciousness subject to clinging."]],[["Ime vuccantāvuso","These, friends, are called,"],["Saṅkhittena","in brief,"],["Pañcupādānakkhandhā dukkhā","the five aggregates subject to clinging that are suffering."],["Idaṃ vuccatāvuso","This, friends, is called"],["Dukkhaṃ ariyasaccaṃ","the noble truth of suffering."]],[["Katamañcāvuso","And what, friends,"],["Dukkhasamudayo ariyasaccaṃ","is the noble truth of the origin of suffering?"]],[["Yāyaṃ taṇhā","It is this craving"],["Ponobbhavikā","that leads to renewed existence,"],["Nandirāgasahagatā","accompanied by delight and lust,"],["Tatra tatrābhinandinī","delighting now here, now there."]],[["Seyyathidaṃ","That is to say:"],["Kāmataṇhā","craving for sensual pleasures,"],["Bhavataṇhā","craving for existence,"],["Vibhavataṇhā","craving for non-existence."],["Idaṃ vuccatāvuso","This, friends, is called"],["Dukkhasamudayo ariyasaccaṃ","the noble truth of the origin of suffering."]],[["Katamañcāvuso","And what, friends,"],["Dukkhanirodho ariyasaccaṃ","is the noble truth of the cessation of suffering?"]],[["Yo tassāyeva taṇhāya","It is, of that very craving,"],["Asesavirāganirodho","the remainderless fading away and cessation,"],["Cāgo","the giving up,"],["Paṭinissaggo","the relinquishing,"],["Mutti","the release,"],["Anālayo","the non-attachment."]],[["Idaṃ vuccatāvuso","This, friends, is called"],["Dukkhanirodho ariyasaccaṃ","the noble truth of the cessation of suffering."]],[["Katamañcāvuso","And what, friends,"],["Dukkhanirodhagāminī paṭipadā ariyasaccaṃ","is the noble truth of the way leading to the cessation of suffering?"]],[["Ayameva","It is just this"],["Ariyo","noble"],["Aṭṭhaṅgiko","eightfold"],["Maggo","path."],["Seyyathidaṃ","That is to say:"]],[["Sammādiṭṭhi","right view,"],["Sammāsaṃkappo","right intention,"],["Sammāvācā","right speech,"],["Sammākammanto","right action,"]],[["Sammāājīvo","right livelihood,"],["Sammāvāyāmo","right effort,"],["Sammāsati","right mindfulness,"],["Sammāsamādhi","right concentration."]],[["Katamā cāvuso","And what, friends,"],["Sammādiṭṭhi","is right view?"]],[["Yaṃ kho āvuso","Whatever, friends,"],["Dukkhe ñāṇaṃ","is knowledge of suffering,"],["Dukkhasamudaye ñāṇaṃ","knowledge of the origin of suffering,"],["Dukkhanirodhe ñāṇaṃ","knowledge of the cessation of suffering,"],["Dukkhanirodhagāminiyā paṭipadāya ñāṇaṃ","knowledge of the way leading to the cessation of suffering:"],["Ayaṃ vuccatāvuso sammādiṭṭhi","this, friends, is called right view."]],[["Katamo cāvuso","And what, friends,"],["Sammāsaṅkappo","is right intention?"]],[["Nekkhammasaṅkappo","The intention of renunciation,"],["Avyāpādasaṅkappo","the intention of non-ill-will,"],["Avihiṃsāsaṅkappo","the intention of harmlessness:"],["Ayaṃ vuccatāvuso sammāsaṅkappo","this, friends, is called right intention."]],[["Katamā cāvuso","And what, friends,"],["Sammāvācā","is right speech?"]],[["Musāvādā veramaṇī","Abstaining from false speech,"],["Pisuṇāya vācāya veramaṇī","abstaining from divisive speech,"],["Pharusāya vācāya veramaṇī","abstaining from harsh speech,"],["Samphappalāpā veramaṇī","abstaining from idle chatter:"],["Ayaṃ vuccatāvuso sammāvācā","this, friends, is called right speech."]],[["Katamo cāvuso","And what, friends,"],["Sammākammanto","is right action?"]],[["Pāṇātipātā veramaṇī","Abstaining from killing living beings,"],["Adinnādānā veramaṇī","abstaining from taking what is not given,"],["Kāmesumicchācārā veramaṇī","abstaining from sexual misconduct:"],["Ayaṃ vuccatāvuso sammākammanto","this, friends, is called right action."]],[["Katamo cāvuso","And what, friends,"],["Sammāājīvo","is right livelihood?"]],[["Idhāvuso","Here, friends,"],["Ariyasāvako","a noble disciple,"],["Micchāājīvaṃ pahāya","having abandoned wrong livelihood,"],["Sammāājīvena","by right livelihood"],["Jīvikaṃ kappeti","makes his living:"],["Ayaṃ vuccatāvuso sammāājīvo","this, friends, is called right livelihood."]],[["Katamo cāvuso","And what, friends,"],["Sammāvāyāmo","is right effort?"]],[["Idhāvuso bhikkhu","Here, friends, a monk,"],["Anuppannānaṃ","of unarisen"],["Pāpakānaṃ","evil"],["Akusalānaṃ dhammānaṃ","unwholesome states"],["Anuppādāya","for the non-arising,"]],[["Chandaṃ janeti","he generates desire,"],["Vāyamati","he strives,"],["Viriyaṃ ārabhati","he arouses energy,"],["Cittaṃ paggaṇhāti","he exerts his mind,"],["Padahati","he endeavours."]],[["Uppannānaṃ","Of arisen"],["Pāpakānaṃ","evil"],["Akusalānaṃ dhammānaṃ","unwholesome states"],["Pahānāya","for the abandoning,"]],[["Chandaṃ janeti","he generates desire,"],["Vāyamati","he strives,"],["Viriyaṃ ārabhati","he arouses energy,"],["Cittaṃ paggaṇhāti","he exerts his mind,"],["Padahati","he endeavours."]],[["Anuppannānaṃ","Of unarisen"],["Kusalānaṃ dhammānaṃ","wholesome states"],["Uppādāya","for the arising,"]],[["Chandaṃ janeti","he generates desire,"],["Vāyamati","he strives,"],["Viriyaṃ ārabhati","he arouses energy,"],["Cittaṃ paggaṇhāti","he exerts his mind,"],["Padahati","he endeavours."]],[["Uppannānaṃ","Of arisen"],["Kusalānaṃ dhammānaṃ","wholesome states"],["Ṭhitiyā","for the continuance,"],["Asammosāya","the non-disappearance,"],["Bhiyyobhāvāya","the increase,"],["Vepullāya","the abundance,"],["Bhāvanāya pāripūriyā","the fulfilment by development,"]],[["Chandaṃ janeti","he generates desire,"],["Vāyamati","he strives,"],["Viriyaṃ ārabhati","he arouses energy,"],["Cittaṃ paggaṇhāti","he exerts his mind,"],["Padahati","he endeavours."],["Ayaṃ vuccatāvuso sammāvāyāmo","This, friends, is called right effort."]],[["Katamā cāvuso","And what, friends,"],["Sammāsati","is right mindfulness?"]],[["Idhāvuso bhikkhu","Here, friends, a monk"],["Kāye","in the body"],["Kāyānupassī","contemplating the body"],["Viharati","dwells,"]],[["Ātāpī","ardent,"],["Sampajāno","clearly comprehending,"],["Satimā","mindful,"],["Vineyya","having removed"],["Loke","with regard to the world"],["Abhijjhā domanassaṃ","covetousness and grief."]],[["Vedanāsu","In feelings"],["Vedanānupassī","contemplating feelings"],["Viharati","he dwells,"]],[["Ātāpī","ardent,"],["Sampajāno","clearly comprehending,"],["Satimā","mindful,"],["Vineyya","having removed"],["Loke","with regard to the world"],["Abhijjhā domanassaṃ","covetousness and grief."]],[["Citte","In the mind"],["Cittānupassī","contemplating the mind"],["Viharati","he dwells,"]],[["Ātāpī","ardent,"],["Sampajāno","clearly comprehending,"],["Satimā","mindful,"],["Vineyya","having removed"],["Loke","with regard to the world"],["Abhijjhā domanassaṃ","covetousness and grief."]],[["Dhammesu","In mental objects"],["Dhammānupassī","contemplating mental objects"],["Viharati","he dwells,"]],[["Ātāpī","ardent,"],["Sampajāno","clearly comprehending,"],["Satimā","mindful,"],["Vineyya","having removed"],["Loke","with regard to the world"],["Abhijjhā domanassaṃ","covetousness and grief."],["Ayaṃ vuccatāvuso sammāsati","This, friends, is called right mindfulness."]],[["Katamo cāvuso","And what, friends,"],["Sammāsamādhi","is right concentration?"]],[["Idhāvuso bhikkhu","Here, friends, a monk,"],["Vivicceva kāmehi","quite secluded from sensual pleasures,"],["Vivicca akusalehi dhammehi","secluded from unwholesome states,"]],[["Savitakkaṃ","accompanied by applied thought,"],["Savicāraṃ","and sustained thought,"],["Vivekajaṃ","born of seclusion,"],["Pītisukhaṃ","with rapture and happiness,"],["Paṭhamaṃ jhānaṃ","the first jhana"],["Upasampajja","having entered upon,"],["Viharati","he dwells."]],[["Vitakkavicārānaṃ vūpasamā","With the stilling of applied and sustained thought,"],["Ajjhattaṃ sampasādanaṃ","with inner confidence,"],["Cetaso ekodibhāvaṃ","and unification of mind,"]],[["Avitakkaṃ","without applied thought,"],["Avicāraṃ","without sustained thought,"],["Samādhijaṃ","born of concentration,"],["Pītisukhaṃ","with rapture and happiness,"],["Dutiyaṃ jhānaṃ","the second jhana"],["Upasampajja","having entered upon,"],["Viharati","he dwells."]],[["Pītiyā ca virāgā","With the fading away of rapture as well,"],["Upekkhako ca viharati","he dwells in equanimity,"],["Sato ca sampajāno","mindful and clearly comprehending,"],["Sukhañca kāyena paṭisaṃvedeti","and he experiences happiness with the body."]],[["Yaṃ taṃ ariyā ācikkhanti","That of which the noble ones declare:"],["Upekkhako","'Equanimous,"],["Satimā","mindful,"],["Sukhavihārīti","he dwells happily',"],["Taṃ tatiyaṃ jhānaṃ","that third jhana"],["Upasampajja","having entered upon,"],["Viharati","he dwells."]],[["Sukhassa ca pahānā","With the abandoning of pleasure"],["Dukkhassa ca pahānā","and the abandoning of pain,"],["Pubbeva","and with the earlier"],["Somanassadomanassānaṃ","of joy and grief"],["Atthaṅgamā","disappearance,"]],[["Adukkhamasukhaṃ","neither painful nor pleasant,"],["Upekkhāsatipārisuddhiṃ","with purity of mindfulness due to equanimity,"],["Catutthaṃ jhānaṃ","the fourth jhana"],["Upasampajja","having entered upon,"],["Viharati","he dwells."]],[["Ayaṃ vuccatāvuso sammāsamādhi","This, friends, is called right concentration."],["Idaṃ vuccatāvuso","This, friends, is called"],["Dukkhanirodhagāminī paṭipadā ariyasaccaṃ","the noble truth of the way leading to the cessation of suffering."]],[["Tathāgatenāvuso","By the Tathagata, friends,"],["Arahatā","the Worthy One,"],["Sammāsambuddhena","the Fully Enlightened One,"]],[["Bārāṇasiyaṃ","at Varanasi,"],["Isipatane","at Isipatana,"],["Migadāye","in the Deer Park,"],["Anuttaraṃ dhammacakkaṃ","the unsurpassed Wheel of Dhamma"],["Pavattitaṃ","was set in motion,"]],[["Appativattiyaṃ","which cannot be turned back"],["Samaṇena vā","by any ascetic,"],["Brāhmaṇena vā","or brahmin,"],["Devena vā","or deity,"],["Mārena vā","or Mara,"],["Brahmunā vā","or Brahma,"],["Kenaci vā lokasmiṃ","or by anyone in the world;"]],[["Yadidaṃ","that is,"],["Imesaṃ catunnaṃ ariyasaccānaṃ","of these Four Noble Truths"],["