rror, or"],["Lomahaṃso vā","horripilation,"],["So","that"],["Pahīyissati","will be abandoned."],["Taṃkissa hetu?","What is the reason for that?"]],[["Tathāgato","The Tathagata,"],["Bhikkhave","Monks,"],["Arahaṃ","being accomplished"],["Sammā sambuddho","and fully awakened,"],["Vītarāgo","is free from lust,"],["Vītadoso","is free from hatred,"],["Vītamoho","is free from delusion;"],["Abhīru","he is not subject to fear,"],["Acchamhi","not subject to terror,"],["Anutrāsi","not subject to fright,"],["Apalāyīti","and not subject to fleeing."]],[["Idamavoca","This was said"],["Bhagavā","by the Blessed One."],["Idaṃ vatvā","Having said this,"],["Sugato","the Sublime One,"],["Athāparaṃ","further"],["Etadavoca","said this:"],["Satthā","the Teacher:"]],[["Araññe","In the forest,"],["Rukkhamūle vā","at the foot of a tree,"],["Suññāgāreva","or in an empty place,"],["Bhikkhavo","Monks,"],["Anussaretha","you should recollect"],["Sambuddhaṃ","the Fully Awakened One,"],["Bhayaṃ","and fear"],["Tumhākaṃ","for you"],["No siyā","will not exist."]],[["No ce buddhaṃ sareyyātha","If you do not recollect the Buddha,"],["Lokajeṭṭhaṃ","the foremost in the world,"],["Narāsabhaṃ","the chief of men,"],["Atha","then"],["Dhamamaṃ","the Dhamma"],["Sareyyātha","you should recollect,"],["Niyyāṇikaṃ","the leading out,"],["Sudesitaṃ","well-expounded."]],[["No ce dhammaṃ sareyyātha","If you do not recollect the Dhamma,"],["Niyyāṇikaṃ","the leading out,"],["Sudesitaṃ","well-expounded,"],["Atha","then"],["Saṃghaṃ","the Sangha"],["Sareyyātha","you should recollect,"],["Puññakhettaṃ","the field of merit,"],["Anuttaraṃ","incomparable."]],[["Evaṃ","Thus,"],["Buddhaṃ","the Buddha,"],["Sarantānaṃ","for those recollecting"],["Dhammaṃ","the Dhamma,"],["Saṃghaṃ ca","and the Sangha,"],["Bhikkhavo","Monks,"],["Bhayaṃ vā","fear, or"],["Chambhitattaṃ vā","terror, or"],["Lomahaṃso","horripilation"],["Na hessatīti","will not occur."]]]}