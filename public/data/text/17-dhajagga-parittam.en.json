Isana, the deity king,"],["Dhajaggaṃ","the crest of the banner"],["Ullekayataṃ","for those looking up at,"],["Yaṃ bhavissati bhayaṃ vā","whatever fear that will arise, or"],["Chambhitattaṃ vā","terror, or"],["Lomahaṃso vā","horripilation,"],["So","that"],["Pahīyethāpi","may be abandoned,"],["No pi pahiyetha","or may not be abandoned."],["Taṃkissahetu?","What is the reason for that?"]],[["Sakkohi bhikkhave devānamindo","Monks, Sakka, the lord of the gods,"],["Avitarāgo","is not free from lust,"],["Avitadoso","is not free from hatred,"],["Avitamoho","is not free from delusion;"],["Bhīru","he is subject to fear,"],["Chambhi","subject to terror,"],["Utrāsi","subject to fright,"],["Palāyīti","and subject to fleeing."]],[["Ahañva kho","But I, indeed,"],["Bhikkhave","Monks,"],["Tumhākaṃ","to you"],["Evaṃ vadāmi","say this:"],["Save","If,"],["Tumhākaṃ","to you,"],["Bhikkhave","Monks,"],["Araññagatānaṃ vā","who have gone to a forest,"],["Rukkhamūlagatānaṃ vā","to the foot of a tree,"],["Suññāgāragatānaṃ vā","or to an empty place,"],["Uppajjeyya","there should arise"],["Bhayaṃ vā","fear, or"],["Chamhitattaṃ vā","terror, or"],["Lomahaṃso vā","horripilation,"],["Mameva","me alone"],["Tasmiṃ samaye","at that time"],["Anussareyyātha","you should recollect:"]],[["Itipi","Thus indeed:"],["So bhagavā","the Blessed One is"],["Arahaṃ","accomplished,"],["Sammā sambuddho","fully awakened,"],["Vijjā caraṇa sampanno","endowed with clear vision and virtuous conduct,"],["Sugato","sublime,"],["Lokavidu","the knower of worlds,"],["Anuntaro","incomparable,"],["Purisa damma sārathi","the leader of persons to be tamed,"],["Satthā devamanussānaṃ","the teacher of gods and humans,"],["Buddho","awakened,"],["Bhagavā’ti","and blessed."]],[["Mamaṃhi vo bhikkhave anussarataṃ","Monks, for you recollecting me,"],["Yaṃ bhavissati bhayaṃ vā","whatever fear there will be, or"],["Chambhitattaṃ vā","terror, or"],["Lomahaṃso vā","horripilation,"],["So","that"],["Pahīyissati","will be abandoned."]],[["No ce maṃ