{"groups":[[["Isigili suttaṃ","The Isigili Discourse"]],[["Evaṃ me sutaṃ","Thus have I heard:"],["Ekaṃ samayaṃ","On one occasion"],["Bhagavā","the Blessed One"],["Rājagahe","in Rajagaha"],["Viharati","was dwelling"],["Isigilismiṃ pabbate","on Mount Isigili."]],[["Tatra kho","Then"],["Bhagavā","the Blessed One"],["Bhikkhū","the monks"],["Āmantesi","addressed,"],["Bhikkhavoti","saying, \"O monks.\""]],[["Bhadanteti","\"Venerable sir,\""],["Te bhikkhū","those monks"],["Bhagavato","to the Blessed One"],["Paccassosuṃ","replied."],["Bhagavā","The Blessed One"],["Etadavoca","said this:"]],[["Passatha no","Do you see,"],["Tumhe bhikkhave","monks,"],["Etaṃ vebhāraṃ pabbatanti","that Mount Vebhara?"],["Evaṃ bhante","\"Yes, venerable sir.\""],["Etassapi kho bhikkhave","Monks, for that"],["Vebhārassa pabbatassa","Mount Vebhara"],["Aññāva samaññā ahosi","there was another name,"],["Aññā paññatti","another designation."]],[["Passatha no","Do you see,"],["Tumhe bhikkhave","monks,"],["Etaṃ paṇḍavaṃ pabbatanti","that Mount Pandava?"],["Evaṃ bhante","\"Yes, venerable sir.\""],["Etassapi kho bhikkhave","Monks, for that"],["Paṇḍavassa pabbatassa","Mount Pandava"],["Aññāva samaññā ahosi","there was another name,"],["Aññā paññatti","another designation."]],[["Passatha no","Do you see,"],["Tumhe bhikkhave","monks,"],["Etaṃ vepullaṃ pabbatanti","that Mount Vepulla?"],["Evaṃ bhante","\"Yes, venerable sir.\""],["Etassapi kho bhikkhave","Monks, for that"],["Vepullassa pabbatassa","Mount Vepulla"],["Aññāva samaññā ahosi","there was another name,"],["Aññā paññatti","another designation."]],[["Passatha no","Do you see,"],["Tumhe bhikkhave","monks,"],["Etaṃ gijjhakūṭaṃ pabbatanti","that Mount Gijjhakuta?"],["Evaṃ bhante","\"Yes, venerable sir.\""],["Etassapi kho bhikkhave","Monks, for that"],["Gijjhakūṭassa pabbatassa","Mount Gijjhakuta"],["Aññāva samaññā ahosi","there was another name,"],["Aññā paññatti","another designation."]],[["Passatha no","Do you see,"],["Tumhe bhikkhave","monks,"],["Imaṃ isigiliṃ pabbatanti","this Mount Isigili?"],["Evaṃ bhante","\"Yes, venerable sir.\""],["Imassa kho bhikkhave","Monks, for this"],["Isigilissa pabbatassa","Mount Isigili"],["Esāva samaññā ahosi","it has always had this very name,"],["Esā paññatti","this very designation."]],[["Bhūtapubbaṃ bhikkhave","Monks, in the past,"],["Pañca paccekabuddhasatāni","five hundred Paccekabuddhas"],["Imasmiṃ isigilismiṃ pabbate","on this Mount Isigili"],["Ciranivāsino ahesuṃ","resided for a long time."],["Te imaṃ pabbataṃ","As they were entering this mountain,"],["Pavisantā dissanti","they could be seen;"],["Paviṭṭhā na dissanti","but once they had entered, they could not be seen."]],[["Tamena manussā disvā","Having seen this, people"],["Evamāhaṃsu","said thus:"],["Ayaṃ pabbato","\"This mountain"],["Ime isī gilatī’ti","swallows these sages.\""],["Isigili isigilītveva samaññā udapādi","Thus the name 'Isigili' (Swallower of Sages) arose."]],[["Ācikkhissāmi bhikkhave","Monks, I will declare"],["Paccekabuddhānaṃ nāmāni","the names of the Paccekabuddhas."],["Kittayissāmi bhikkhave","Monks, I will reveal"],["Paccekabuddhānaṃ nāmāni","the names of the Paccekabuddhas."],["Desessāmi bhikkhave","Monks, I will teach"],["Paccekabuddhānaṃ nāmāni","the names of the Paccekabuddhas."],["Taṃ suṇātha","Listen to it,"],["Sādhukaṃ manasi karotha","pay close attention,"],["Bhāsissāmīti","I will speak.\""]],[["Evaṃ bhanteti kho","\"Yes, venerable sir,\""],["Te bhikkhū","those monks"],["Bhagavato paccassosuṃ","replied to the Blessed One."],["Bhagavā etadavoca","The Blessed One said this:"]],[["Ariṭṭho nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Arittha"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Upariṭṭho nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Uparittha"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Tagarasikhī nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Tagarasikhi"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Yasassī nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Yasassi"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Sudassano nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Sudassana"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Piyadassī nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Piyadassi"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Gandhāro nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Gandhara"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Piṇḍolo nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Pindola"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Upāsabho nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Upasabha"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Nīto nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Nita"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Tatho nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Tatha"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Sutavā nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Sutava"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi","resided for a long time on this Mount Isigili."]],[["Bhāvitatto nāma bhikkhave paccekasambuddho","Monks, the Paccekabuddha named Bhavitatta"],["Imasmiṃ isigilismiṃ pabbate ciranivāsī ahosi’ti","resided for a long time on this Mount Isigili.\""]],[["Ye sattasārā","Those excellent beings"],["Anīghā","free from suffering"],["Nirāsā","free from craving"],["Paccekamevajjhagamuṃ subodhiṃ","attained full awakening individually;"],["Tesaṃ visallāna naruttamānaṃ","of those supreme men who have removed the dart of defilements,"],["Nāmāni me kittayato suṇātha","listen to me as I proclaim their names."]],[["Ariṭṭho","Arittha,"],["Upariṭṭho","Uparittha,"],["Tagarasikhī","Tagarasikhi,"],["Yasassī","Yasassi,"],["Sudassano","Sudassana,"],["Piyadassī ca buddho","and the Buddha Piyadassi,"],["Gandhāro","Gandhara,"],["Piṇḍolo","Pindola,"],["Upāsabho ca","and Upasabha,"],["Nīto","Nita,"],["Tatho","Tatha,"],["Sutavā","Sutava,"],["Bhāvitatto","Bhavitatta,"]],[["Sumbho","Sumbha,"],["Subho","Subha,"],["Methulo","Methula,"],["Aṭṭhamo ca","and Atthama,"],["Athassumegho","and then Megha,"],["Anīgho","Anigha,"],["Sudāṭho","Sudatha;"],["Paccekabuddhā bhavanettikhīṇā","these Paccekabuddhas have destroyed the conduit to existence."],["Hiṅgū ca hiṅgo ca","Hingu and Hinga,"],["Mahānubhāvā","are of great power."]],[["Dve jālino munino","The two sages named Jali,"],["Aṭṭhako ca","and Atthaka,"],["Atha kosalo buddho","then the Buddha Kosala,"],["Atho subāhu","and then Subahu,"],["Upanemiso","Upanemisa,"],["Nemiso","Nemisa,"],["Santacitto","Santacitta,"],["Sacco","Sacca,"],["Tatho","Tatha,"],["Virajo","Viraja,"],["Paṇḍito ca","and Pandita."]],[["Kālūpakālā","Kala and Upakala,"],["Vijito","Vijita,"],["Jito ca","and Jita,"],["Aṅgo ca","Anga,"],["Paṅgo ca","and Panga,"],["Guttijito ca","and Guttijita."],["Passī","Passi"],["Jahī upadhiṃ dukkhamūlaṃ","abandoned the defilements, the root of suffering."],["Aparājito mārabalaṃ ajesi","Aparajita defeated the army of Mara."]],[["Satthā","Sattha,"],["Pavattā","Pavatta,"],["Sarabhaṅgo","Sarabhanga,"],["Lomahaṃso","Lomahamsa,"],["Uccaṅgamāyo","Uccangamaya,"],["Asito","Asita,"],["Anāsavo","Anasava,"],["Manomayo","Manomaya,"],["Mānacchido ca","and the destroyer of conceit,"],["Bandhumā","Bandhuma;"],["Ta