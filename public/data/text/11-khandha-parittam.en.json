{"groups":[[["Khandha parittaṃ","The Khandha Protection"]],[["Evaṃ","Thus"],["Me","by me"],["Sutaṃ","it was heard:"],["Ekaṃ samayaṃ","On one occasion"],["Bhagavā","the Blessed One"],["Sāvatthiyaṃ","in Savatthi"],["Viharati","was dwelling"],["Jetavane","in Jeta's Grove,"],["Anātha piṇḍikassa","Anathapindika's"],["Ārāme","monastery."]],[["Tena kho pana samayena","Now at that time"],["Sāvatthiyaṃ","in Savatthi"],["Aññataro bhikkhu","a certain monk"],["Ahinā daṭṭho","was bitten by a snake"],["Kālakato hoti","and passed away."]],[["Atha kho","Then"],["Sambahulā bhikkhu","many monks"],["Yena bhagavā","where the Blessed One was,"],["Tenupasaṃkamiṃsu","there they approached."],["Upasaṃkamitvā","Having approached,"],["Bhagavantaṃ","the Blessed One,"],["Abhivādetvā","having paid homage,"],["Ekamantaṃ","to one side"],["Nisīdiṃsu","they sat down."]],[["Ekamantaṃ","To one side"],["Nisinno kho","seated,"],["Te bhikkhu","those monks"],["Bhagavantaṃ","to the Blessed One"],["Etadavocuṃ","said this:"]],[["Idha bhante sāvatthiyaṃ","Venerable sir, here in Savatthi"],["Aññataro bhikkhu","a certain monk"],["Ahinā daṭṭho","was bitten by a snake"],["Kāla kato’ ti","and has passed away."]],[["Naha nūna so bhikkhave bhikkhu","Monks, surely that monk did not"],["Cattāri ahirāja kulāni","to the four royal snake families"],["Mettena cittena","with a mind of loving-kindness"],["Phari","radiate."]],[["Sacehi","For if"],["So bhikkhave bhikkhu","monks, that monk"],["Cattāri ahirāja kulāni","to the four royal snake families"],["Mettena cittena","with a mind of loving-kindness"],["Ereyya","had radiated,"],["Nahi","not"],["So bhikkhave bhikkhu","monks, would that monk"],["Abhinā daṭṭho","having been bitten by a snake"],["Kālaṃkareyya","have passed away."]],[["Katamāni","What are"],["Cattāri ahirājakulāni","the four royal snake families?"],["Virūpakkhaṃ ahirājakulaṃ","The Virupakkha royal snake family,"],["Erāpathaṃ ahirājakulaṃ","the Erapatha royal snake family,"],["Chakhyāputtaṃ ahirājakulaṃ","the Ch