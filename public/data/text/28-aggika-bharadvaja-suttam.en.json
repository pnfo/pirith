{"groups":[[["Aggika bhāradvāja suttaṃ","The Discourse to Aggika Bhāradvāja"]],[["Evaṃ me sutaṃ","Thus have I heard:"],["Ekaṃ samayaṃ","On one occasion"],["Bhagavā","the Blessed One"],["Sāvatthiyaṃ viharati","was dwelling at Sāvatthi,"],["Jetavane","in Jeta's Grove,"],["Anāthapiṇḍikassa ārāme","in Anāthapiṇḍika's monastery."]],[["Atha kho bhagavā","Then the Blessed One,"],["Pubbanha samayaṃ","in the morning,"],["Nivāsetvā","having dressed,"],["Pattacīvaraṃ ādāya","taking his bowl and robe,"],["Sāvatthiyaṃ","into Sāvatthi"],["Piṇḍāya pāvisi","entered for alms."]],[["Tena kho pana samayena","Now at that time,"],["Aggika bhāradvājassa brāhmaṇassa","of the brahmin Aggika Bhāradvāja,"],["Nivesane","in the house"],["Aggi pajjalito hoti","a fire was burning"],["Āhuti paggahitā","and the oblation was held ready."]],[["Atha kho bhagavā","Then the Blessed One,"],["Sāvatthiyaṃ","in Sāvatthi,"],["Sapadānaṃ","from house to house in order,"],["Piṇḍāya caramāno","walking for alms,"],["Yena aggikabhāradvājassa brāhmaṇassa nivesanaṃ","to where the house of the brahmin Aggika Bhāradvāja was,"],["Tenupasaṅkami","there he approached."]],[["Addasā kho","He saw,"],["Aggikabhāradvājo brāhmaṇo","the brahmin Aggika Bhāradvāja,"],["Bhagavantaṃ","the Blessed One"],["Dūratova āgacchantaṃ","coming from afar."],["Disvāna","Having seen him,"],["Bhagavantaṃ etadavoca","he said this to the Blessed One:"]],[["Tatreva muṇḍaka","\"Stop right there, shaveling!"],["Tatreva samaṇaka","Right there, wretched ascetic!"],["Tatreva vasalaka tiṭṭhāhīti","Stay right there, outcast!\""]],[["Evaṃ vutte","When this was said,"],["Bhagavā","the Blessed One"],["Aggikabhāradvājaṃ brāhmaṇaṃ","to the brahmin Aggika Bhāradvāja"],["Etadavoca","said this:"],["Jānāsi pana tvaṃ brāhmaṇa","\"But do you know, brahmin,"],["Vasalaṃ vā","what an outcast is,"],["Vasalakaraṇe vā dhammeti","or the things that make one an outcast?\""]],[["Nakhvāhaṃ bho gotama jānāmi","\"No, Master Gotama, I do not know"],["Vasalaṃ vā","what an outcast is,"],["Vasalakaraṇe vā dhamme","or the things that make one an outcast."]],[["Sādhu me bhavaṃ gotamo","It would be good if Master Gotama, for me,"],["Tathā dhammaṃ desetu","would teach the Dhamma in such a way"],["Yathāhaṃ jāneyyaṃ","that I may come to know"],["Vasalaṃ vā","what an outcast is,"],["Vasalakaraṇe vā dhammeti","or the things that make one an outcast.\""]],[["Tena hi brāhmaṇa","\"Then, brahmin,"],["Suṇāhi","listen,"],["Sādhukaṃ manasi karohi","pay careful attention;"],["Bhāsissāmīti","I shall speak.\""]],[["Evaṃ bhoti kho","\"Yes, sir,\""],["Aggikabhāradvājo brāhmaṇo","the brahmin Aggika Bhāradvāja"],["Bhagavato paccassosī","replied to the Blessed One."],["Bhagavā etadavoca","The Blessed One said this:"]],[["Kodhano upanāhī ca","\"Whoever is angry and bears a grudge,"],["Pāpamakkhī ca yo naro","the man who is evil and disparages others' virtues,"],["Vipannadiṭṭhi māyāvī","who holds wrong views and is deceitful,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Ekajaṃ va dvījaṃ vāpi","Whether once-born or twice-born,"],["Yodha pāṇāni hiṃsati","whoever here harms living beings,"],["Yassa pāṇe dayā natthi","who has no compassion for living creatures,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo hanti parirundhati","Whoever destroys and besieges"],["Gāmāni nigamāni ca","villages and market towns,"],["Niggāhako samaññāto","and is notorious as an oppressor,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Gāme vā yadi vā raññe","Whether in a village or in the forest,"],["Yaṃ paresaṃ mamāyitaṃ","whatever is cherished by others as their own,"],["Theyyā adinnaṃ ādiyati","whoever takes by theft what is not given,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo have iṇamādāya","Whoever, having truly taken on a debt,"],["Cujjamāno palāyati","runs away when pressed to repay,"],["Na hi te iṇamatthiti","saying, 'I owe you no debt,'"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo ce kiñcikkhakamyatā","Whoever, out of desire for some trifle,"],["Panthasmiṃ vajataṃ janaṃ","a person travelling along the road"],["Hantvā kiñcīkkhamādeti","kills, and takes that trifle,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo attahetu parahetu","For his own sake or for another's sake,"],["Dhanahetū ca yo naro","or for the sake of wealth, the man who,"],["Sakkhipuṭṭho musā brūti","when questioned as a witness, speaks falsely,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo ñātinaṃ sakhānaṃ vā","Whoever, with relatives' or friends'"],["Dāresu patidissati","wives is seen misbehaving,"],["Sahasā sampiyena vā","whether by force or by mutual consent,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo mātaraṃ vā pitaraṃ vā","Whoever his mother or father,"],["Jiṇṇakaṃ gatayobbanaṃ","aged and past their youth,"],["Pahū santo na bharati","though being able, does not support,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo mātaraṃ vā pitaraṃ vā","Whoever his mother or father,"],["Bhātaraṃ bhaginiṃ sasuṃ","brother, sister or mother-in-law"],["Hanti roseti vācāya","strikes, or angers with words,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo atthaṃ pucchito santo","Whoever, when asked about what is beneficial,"],["Anatthamanusāsati","teaches what is harmful,"],["Paṭicchannena manteti","and gives counsel in a concealed way,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo katvā pāpakaṃ kammaṃ","Whoever, having done an evil deed,"],["Mā maṃ jaññāti icchati","wishes, 'May no one know me,'"],["Yo paṭicchannakammanto","whoever is a doer of hidden deeds,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo ve parakulaṃ gantvā","Whoever, having gone to another's home"],["Bhutvāna sucibhojanaṃ","and eaten fine food there,"],["Āgataṃ na paṭipūjeti","does not honour that host in return when he comes,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo brāhmaṇaṃ vā samaṇaṃ vā","Whoever a brahmin or an ascetic,"],["Aññaṃ vāpi vaṇibbakaṃ","or any other mendicant,"],["Musāvādena vañceti","deceives with false speech,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo brāhmaṇaṃ vā samaṇaṃ vā","Whoever a brahmin or an ascetic,"],["Bhattakāle upaṭṭhite","when mealtime has arrived,"],["Roseti vācā na ca deti","angers with words and gives nothing,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Asataṃ yodha pabrūti","Whoever here speaks what is untrue,"],["Mohena paḷiguṇṭhito","wrapped up in delusion,"],["Kiñcikkhaṃ nijigiṃsāno","grasping after some trifle,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo cattānaṃ samukkaṃse","Whoever exalts himself"],["Parañca mavajānati","and despises others,"],["Nihīno sena mānena","debased by his own conceit,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Rosako kadariyo ca","One who provokes anger and is stingy,"],["Pāpiccho maccharī saṭho","of evil wishes, miserly and crafty,"],["Ahiriko anottāpī","shameless and without fear of wrongdoing,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo buddhaṃ paribhāsati","Whoever reviles the Buddha,"],["Atha vā tassa sāvakaṃ","or a disciple of his,"],["Paribbājaṃ gahaṭṭhaṃ vā","whether a wanderer or a householder,"],["Taṃ jaññā vasalo iti","know him as an outcast."]],[["Yo ce anarahā santo","Whoever, though not being an arahant,"],["Arahaṃ paṭijānāti","claims to be an arahant,"],["Coro sabrahmake loke","is a thief in the world together with its Brahmās;"],["Esa kho vasalādhamo","he indeed is the lowest of outcasts."],["Ete kho vasalā vuttā","These indeed are called outcasts,"],["Mayā vo ye pakāsitā","those whom I have made known to you."]],[["Na jaccā vasalo hoti","Not by birth is one an outcast,"],["Na jaccā hoti brāhmaṇo","not by birth is one a brahmin."],["Kammanā vasalo hoti","By deed one becomes an outcast,"],["Kammanā hoti brāhmaṇo","by deed one becomes a brahmin."]],[["Tadamināpi jānātha","Know it also by this,"],["Yathā medaṃ nidassanaṃ","as by this example of mine:"],["Caṇḍālaputto sopāko","there was an outcast's son, Sopāka,"],["Mātaṅgo iti vissuto","renowned as Mātaṅga."]],[["So yasaṃ paramaṃ patto","He attained the highest fame,"],["Mātaṅgo yaṃ sudullabhaṃ","this Mātaṅga, fame so very hard to gain."],["Āgañchuṃ tassupaṭṭhānaṃ","There came to attend upon him"],["Khattiyā brāhmaṇā bahū","many nobles and brahmins."]],[["So devayānamāruyha","He mounted the divine vehicle,"],["Virajaṃ so mahāpathaṃ","the stainless great highway;"],["Kāmarāgaṃ virājetvā","having discarded sensual passion,"],["Brahmalokūpago ahū","he became one reborn in the Brahma world."]],[["Na naṃ jāti nivāresi","Birth did not prevent him"],["Brahmalokūpapattiyā","from rebirth in the Brahma world."],["Ajjhāyakakule jātā","Those born into a family of Vedic reciters,"],["Brāhmaṇā mantabandhūno","brahmins who are kinsmen of the sacred hymns,"]],[["Te va pāpesu kammesu","even they, in evil deeds,"],["Abhiṇhamupadissare","are repeatedly seen to be involved."],["Diṭṭheva dhamme gārayhā","In this very life they are blameworthy,"],["Samparāye ca duggatiṃ","and in the next life there is a bad destination."],["Na te jāti nivāreti","Birth does not protect them"],["Duggaccā garahāya vā","from a bad destination or from blame."]],[["Na jaccā vasalo hoti","Not by birth is one an outcast,"],["Na jaccā hoti brāhmaṇo","not by birth is one a brahmin."],["Kammanā vasalo hoti","By deed one becomes an outcast,"],["Kammanā hoti brāhmaṇo","by deed one becomes a brahmin.\""]],[["Evaṃ vutte","When this was said,"],["Aggikabhāradvājo brāhmaṇo","the brahmin Aggika Bhāradvāja"],["Bhagavantaṃ etadavoca","said this to the Blessed One:"]],[["Abhikkantaṃ bho gotama","\"Excellent, Master Gotama!"],["Abhikkantaṃ bho gotama","Excellent, Master Gotama!"],["Seyyathāpi bho gotama","Just as, Master Gotama,"],["Nikkujjitaṃ vā ukkujjeyya","one might set upright what had been overturned,"],["Paṭicchannaṃ vā vivareyya","or reveal what was hidden,"],["Mūḷhassa vā maggaṃ ācikkheyya","or show the way to one who was lost,"],["Andhakāre vā telapajjotaṃ dhāreyya","or hold up an oil lamp in the darkness"],["Cakkhumanto rūpāni dakkhintīti","so that those with eyes might see forms,"]],[["Evameva bhotā gotamena","in the same way, by Master Gotama,"],["Anekapariyāyena","in many ways,"],["Dhammo pakāsito","the Dhamma has been made clear."]],[["Esāhaṃ","I"],["Bhavantaṃ gotamaṃ","to Master Gotama"],["Saraṇaṃ gacchāmi","go for refuge,"],["Dhammañca bhikkhusaṅghañca","and to the Dhamma and to the Saṅgha of monks."]],[["Upāsakaṃ maṃ","As a lay follower, me"],["Bhavaṃ gotamo dhāretu","may Master Gotama remember,"],["Ajjatagge","from this day forth,"],["Pāṇupetaṃ","for as long as life lasts,"],["Saraṇaṃ gatanti","as one who has gone for refuge.\""]]]}